<article class="article">
  <p class="kicker">MAVS.KR / <%= @kind.upcase %></p>
  <h1 class="pageTitle"><%= @article['title'] %></h1>
  <p class="intro"><time datetime="<%= @article['date'].iso8601 %>"><%= @article['date'].strftime('%Y-%m-%d') %></time> · <%= @article['author'] %></p>
  <% if @article['autoGenerated'] %><p class="note">자동 생성 콘텐츠 · 출처와 원문을 함께 확인해 주세요.</p><% end %>
  <% if @image_url %><img class="articleImage" src="<%= @image_url %>" alt="<%= @article['title'] %>" fetchpriority="high"><% end %>
  <div class="articleBody"><%= migrated_content(@article['content']) %></div>
  <% if @article['category'] == 'MARKET' && !@article['price'].nil? %><p><strong>가격</strong> <%= fmt(@article['price']) %>원</p><% end %>
  <% if @article['meetupLocation'].present? %><p><strong>모임 장소</strong> <%= @article['meetupLocation'] %></p><% end %>
  <% if @article['meetupDate'] %><p><strong>모임 일시</strong> <%= @article['meetupDate'].strftime('%Y-%m-%d %H:%M UTC') %></p><% end %>
  <% Array(@article['images']).uniq.each do |url| %>
    <% if safe_external_url(url) %><img class="articleImage" src="<%= MediaArchive.local_url(url) %>" alt="" loading="lazy"><% end %>
  <% end %>
  <% Array(@article['snsLinks']).uniq.each do |url| %>
    <% if safe_external_url(url) %><p><a href="<%= url %>" rel="noopener noreferrer nofollow">관련 링크 ↗</a></p><% end %>
  <% end %>
  <% if safe_external_url(@article['sourceUrl']) %><p class="note"><a href="<%= @article['sourceUrl'] %>" rel="noopener noreferrer nofollow">원문 출처 ↗</a></p><% end %>
</article>
<% if @article['comments'] %>
<section class="panel contentCard"><h2>댓글 <%= @article['comments'].length %></h2>
<% @article['comments'].each do |comment| %><article><strong><%= comment['author'] %></strong><p><%= comment['content'] %></p></article><% end %>
<p><a href="<%= Rails.application.config.x.legacy_origin %>/community/<%= ERB::Util.url_encode(@article['id']) %>">로그인하여 댓글 작성</a></p>
</section>
<% end %>
